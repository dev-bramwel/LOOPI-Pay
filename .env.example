# Copy this file to .env and replace the placeholder values.
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

POSTGRES_DB=loopipay
POSTGRES_USER=loopipay
POSTGRES_PASSWORD=replace-with-a-database-password

# Console email keeps local registration emails in backend logs. Replace these
# values with SMTP settings when you need delivery to a real inbox.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@localhost

FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8000
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
