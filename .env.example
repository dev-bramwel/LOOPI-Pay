# Copy this file to .env and replace the placeholder values.
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

POSTGRES_DB=loopipay
POSTGRES_USER=loopipay
POSTGRES_PASSWORD=replace-with-a-database-password

# SMTP is required for registration emails to reach an inbox.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=replace-with-your-smtp-password
DEFAULT_FROM_EMAIL=no-reply@yourdomain.com

FRONTEND_URL=http://localhost:5173
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
